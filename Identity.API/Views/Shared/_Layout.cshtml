<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OneMoney Identity</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 24rem; }
        label { display: block; margin-top: 0.75rem; }
        input[type="email"], input[type="password"] { width: 100%; padding: 0.5rem; box-sizing: border-box; }
        button { margin-top: 1rem; padding: 0.5rem 1rem; }
        .validation-summary-errors { color: #b00020; }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
